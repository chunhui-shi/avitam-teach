# v2-deployed: template for docker-compose environment.
#
# Copy to .env.docker (gitignored) and fill in real values before running
# `docker compose up`. The app container will fail fast at startup via
# src/lib/env.ts if any required variable is missing or malformed.

# ---- Postgres service (docker-compose postgres container) -----------------
POSTGRES_USER=avitam
POSTGRES_PASSWORD=changeme-in-dev
POSTGRES_DB=avitam_teach

# ---- App container --------------------------------------------------------
# DATABASE_URL points at the compose-internal `postgres` hostname, NOT
# localhost, because the app container talks to the DB over the compose
# network.
DATABASE_URL=postgresql://avitam:changeme-in-dev@postgres:5432/avitam_teach

# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-real-32-plus-character-random-secret

# Stripe test mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL the app advertises to clients (Stripe redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key for the per-lesson AI assistant
ANTHROPIC_API_KEY=sk-ant-replace-me

# Next.js runtime mode — leave as production for container runs.
NODE_ENV=production
